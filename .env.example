# Copy this file to ".env" (same folder) and fill in your own values.
# .env is git-ignored. NEVER commit real values. This file contains placeholders only.

# ---------------------------------------------------------------------------
# Backend mode
#   firebase = use your Firebase project (default; required on Netlify)
#   memory   = LOCAL DEMO ONLY (not connected to Firebase). Data is kept in memory and lost when you stop
#              the dev server. Refuses to run on a deployed site.
# ---------------------------------------------------------------------------
BACKEND_MODE=firebase

# Everyone signs in with Google. Only emails an admin registered (Admin > Users) can sign in.

# Local test sign-in WITHOUT a password, for development only. Only works on localhost;
# the server refuses to start if this is set on a deployed site.
DEV_STAFF_LOGIN=false
# Test sign-in accounts (memory mode, or DEV_STAFF_LOGIN=true). Comma separated.
DEV_ADMIN_EMAILS=dev.admin@example.test
DEV_STAFF_EMAILS=dev.staff@example.test
# Phone testing over Wi-Fi: `npm run dev:lan`. Phones must enter a passcode, randomly generated and printed in
# the terminal at every start. Optional fixed passcode (8+ characters) and Wi-Fi address override:
# DEV_LAN_PASSCODE=
# DEV_LAN_HOST=192.168.0.16

# Base URL printed into QR codes and tracking links. Use your real deployed URL
# before printing labels. Labels printed with a localhost URL will NOT work for customers.
PUBLIC_BASE_URL=http://localhost:5173

# Time zone used to decide "today" and overdue loans (IANA name, e.g. Asia/Singapore).
APP_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# SERVER-SIDE Firebase Admin credentials (from a service account key).
# These stay on the server. Never prefix them with VITE_.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Only if your Firestore database is NOT named "(default)":
# FIRESTORE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Paste the private key on ONE line with \n where the line breaks are, inside double quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# BROWSER Firebase config (public web-app settings, safe to expose; NOT secrets).
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-web-app-id

# ---------------------------------------------------------------------------
# Optional: local Firebase emulators (needs Java 21+). Leave commented out otherwise.
# ---------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
